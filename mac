#!/bin/sh

# Welcome to the Pavilion laptop script!
# Please take a moment to read *and customize* this script before running.
# The packages below are helpful suggestions, not a prescriptive list.
# In particular, you may want to add your favorite code editor.

# shellcheck disable=SC3043

fancy_echo() {
  local fmt="$1"; shift

  # shellcheck disable=SC2059
  printf "\\n$fmt\\n" "$@"
}

append_to_zshrc() {
  local text="$1" zshrc
  local skip_new_line="${2:-0}"

  if [ -w "$HOME/.zshrc.local" ]; then
    zshrc="$HOME/.zshrc.local"
  else
    zshrc="$HOME/.zshrc"
  fi

  if ! grep -Fqs "$text" "$zshrc"; then
    if [ "$skip_new_line" -eq 1 ]; then
      printf "%s\\n" "$text" >> "$zshrc"
    else
      printf "\\n%s\\n" "$text" >> "$zshrc"
    fi
  fi
}

# shellcheck disable=SC2154
trap 'ret=$?; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT

set -e

if [ ! -d "$HOME/.bin/" ]; then
  mkdir "$HOME/.bin"
fi

# Oh My Zsh replaces ~/.zshrc with its template, so install it before anything
# below appends to that file.
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  fancy_echo "Installing ohmyzsh framework for zsh ..."
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

if [ ! -f "$HOME/.zshrc" ]; then
  touch "$HOME/.zshrc"
fi

# shellcheck disable=SC2016
append_to_zshrc 'export PATH="$HOME/.bin:$PATH"'

# Determine Homebrew prefix
arch="$(uname -m)"
if [ "$arch" = "arm64" ]; then
  HOMEBREW_PREFIX="/opt/homebrew"
else
  HOMEBREW_PREFIX="/usr/local"
fi

if [ "${SHELL##*/}" != "zsh" ]; then
  fancy_echo "Changing your shell to zsh ..."
  chsh -s /bin/zsh
fi

if [ ! -x "$HOMEBREW_PREFIX/bin/brew" ]; then
  fancy_echo "Installing Homebrew ..."
  /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

append_to_zshrc "eval \"\$($HOMEBREW_PREFIX/bin/brew shellenv)\""
eval "$("$HOMEBREW_PREFIX/bin/brew" shellenv)"

export NVM_DIR="$HOME/.nvm"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  fancy_echo "Installing nvm ..."
  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
fi
# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh"

# Homebrew only ships the latest uv, but projects pin an exact uv version that
# uv refuses to run under. The standalone install can be moved to any version
# with `uv self update <version>`.
if [ ! -x "$HOME/.local/bin/uv" ]; then
  fancy_echo "Installing uv ..."
  curl -LsSf https://astral.sh/uv/install.sh | sh
fi

fancy_echo "Please review and customize this script before running so that it meets your needs!"
fancy_echo "Updating Homebrew formulae ..."
brew update
brew bundle --file=- <<EOF
# Unix
brew "gh"
brew "htop"
brew "jq"
brew "ripgrep"
brew "tmux"

# Programming languages and version managers
brew "bun"
brew "tfenv"

# Databases
brew "postgresql@17", restart_service: :changed
brew "postgis"
brew "redis", restart_service: :changed

# Development tools
brew "awscli"

# Applications (uncomment back in to install)
# cask "tailscale-app"
# cask "google-chrome"
# cask "slack"
# cask "iterm2"
# cask "visual-studio-code"
# cask "cursor"
# cask "sublime-text"
# cask "sublime-merge"
# cask "orbstack"
# cask "insomnia"
# cask "bitwarden"
# cask "tableplus"
EOF

fancy_echo "Installing Node.js ..."
nvm install 24
nvm alias default 24

if [ -f "$HOME/.laptop.local" ]; then
  fancy_echo "Running your customizations from ~/.laptop.local ..."
  # shellcheck disable=SC1091
  . "$HOME/.laptop.local"
fi

fancy_echo "Don't forget to scroll up through the install logs above to see if any packages have setup/config instructions!"
fancy_echo "Also, you may enjoy some of the modifications in the zshrc-additions file in this repo."
